{
  "name": "@nomadamas/im-not-llm",
  "version": "0.1.0",
  "description": "im-not-llm's on-device engines (dense text embeddings, learned sparse, loopback daemon) as an in-process Node-API addon",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NomaDamas/im-not-llm.git",
    "directory": "bindings/node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "binding.js",
    "binding.d.ts"
  ],
  "engines": {
    "node": ">= 18"
  },
  "napi": {
    "binaryName": "im-not-llm-native",
    "packageName": "@nomadamas/im-not-llm",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --js binding.js --dts binding.d.ts",
    "artifacts": "napi artifacts",
    "test": "node --test \"__test__/*.test.mjs\""
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8"
  }
}
